    "@tiptap/vue-3": "^2.11.5",
    "@vueuse/core": "^11.3.0",
    "axios": "^1.7.7",
    "cropperjs": "^1.6.2",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.4.3",
    "dompurify": "^3.2.4",
    "echarts": "^5.5.1",
    "element-plus": "^2.14.7",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
