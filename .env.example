# ============================================================
# 前端环境变量模板（入库）— 真实环境值可直接写对应 .env.<mode> 文件
# 模式 <-> 文件（Vite）：
#   npm run dev           -> .env + .env.development
#   npm run build:test    -> .env + .env.test
#   npm run build:pre     -> .env + .env.pre
#   npm run build:prod    -> .env + .env.production
#
# Vite 仅以 VITE_ 前缀的变量注入前端（import.meta.env.*）
# 开发用 /api（vite proxy 转发到后端 2025）；生产/测试/预发填真实后端地址。
# ============================================================
VITE_APP_TITLE=火星财务管理系统
VITE_API_BASE=/api
